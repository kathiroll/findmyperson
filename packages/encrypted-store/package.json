{
  "name": "@findmyperson/encrypted-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@findmyperson/shared": "workspace:*",
    "@op-engineering/op-sqlite": "18.2.5"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@journeyapps/sqlcipher": "^6.0.0",
    "@react-native/codegen": "0.87.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.1.1",
    "prettier": "^3.9.9",
    "react": "19.2.3",
    "react-native": "0.87.1"
  },
  "codegenConfig": {
    "name": "NativeEncryptedStoreSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "dev.findmyperson.encryptedstore"
    },
    "ios": {
      "modulesProvider": {
        "NativeEncryptedStore": "RCTNativeEncryptedStore"
      }
    }
  }
}
