<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and earlier: nothing the app stores is part of a full backup. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
