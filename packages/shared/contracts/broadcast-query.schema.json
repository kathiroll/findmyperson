{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": { "type": "number", "const": 1 },
    "query_id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "key_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "issued_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "expires_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "center": {
      "type": "object",
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lon": { "type": "number", "minimum": -180, "maximum": 180 }
      },
      "required": ["lat", "lon"]
    },
    "radius_m": { "type": "integer", "minimum": 0, "maximum": 5000 },
    "window": {
      "type": "object",
      "properties": {
        "from": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "to": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["from", "to"]
    },
    "cells": { "minItems": 1, "maxItems": 128, "type": "array", "items": { "type": "string" } },
    "person": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 1000 },
        "photo": {
          "type": "object",
          "properties": {
            "mime": { "type": "string", "enum": ["image/webp", "image/jpeg"] },
            "w": { "type": "integer", "minimum": 1, "maximum": 256 },
            "h": { "type": "integer", "minimum": 1, "maximum": 256 },
            "b64": {
              "type": "string",
              "minLength": 4,
              "maxLength": 32768,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            }
          },
          "required": ["mime", "w", "h", "b64"]
        }
      },
      "required": ["name", "description"]
    },
    "reporter_phone": { "type": "string", "pattern": "^\\+[1-9][0-9]{6,14}$" },
    "respond": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string", "maxLength": 2048, "pattern": "^https:\\/\\/[^\\s]+$" }
      },
      "required": ["endpoint"]
    },
    "sig": { "type": "string", "pattern": "^ed25519:[A-Za-z0-9_-]{86}$" }
  },
  "required": [
    "v",
    "query_id",
    "revision",
    "key_id",
    "issued_at",
    "expires_at",
    "center",
    "radius_m",
    "window",
    "cells",
    "person",
    "reporter_phone",
    "respond",
    "sig"
  ],
  "$comment": "GENERATED from packages/shared/src/payload by jsonSchema.test.ts; do not edit by hand. Members not listed here are allowed and must be ignored by a reader. Cross-field rules and H3 cell validity are not expressible here: see the zod schema."
}
