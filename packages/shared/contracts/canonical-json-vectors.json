{
  "_comment": "Golden vectors for canonical JSON (RFC 8785). `canonical` is the exact text canonicalJson(value) must return. Two vectors are the worked examples from the RFC. See contracts/README.md.",
  "vectors": [
    {
      "name": "empty-object",
      "value": {},
      "canonical": "{}"
    },
    {
      "name": "empty-array",
      "value": [],
      "canonical": "[]"
    },
    {
      "name": "literals",
      "value": [null, true, false],
      "canonical": "[null,true,false]"
    },
    {
      "name": "keys-sorted-nested",
      "value": {
        "b": 1,
        "a": {
          "d": 1,
          "c": 2
        },
        "aa": [
          {
            "z": 1,
            "y": 2
          }
        ]
      },
      "canonical": "{\"a\":{\"c\":2,\"d\":1},\"aa\":[{\"y\":2,\"z\":1}],\"b\":1}"
    },
    {
      "name": "rfc8785-3.2.3-key-order-is-utf16-code-units",
      "value": {
        "1": "One",
        "€": "Euro Sign",
        "\r": "Carriage Return",
        "דּ": "Hebrew Letter Dalet With Dagesh",
        "😀": "Emoji: Grinning Face",
        "\u0080": "Control",
        "ö": "Latin Small Letter O With Diaeresis"
      },
      "canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"ö\":\"Latin Small Letter O With Diaeresis\",\"€\":\"Euro Sign\",\"😀\":\"Emoji: Grinning Face\",\"דּ\":\"Hebrew Letter Dalet With Dagesh\"}"
    },
    {
      "name": "rfc8785-3.2.2-numbers-and-string-escapes",
      "value": {
        "numbers": [333333333.3333333, 1e30, 4.5, 0.002, 1e-27],
        "string": "€$\u000f\nA'B\"\\\\\"/",
        "literals": [null, true, false]
      },
      "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}"
    },
    {
      "name": "number-forms",
      "value": [0, 0, 1, -1, 1.5, 100, 1e21, 1e-7, 0.000001, 9007199254740991, 12.9716, -77.5946],
      "canonical": "[0,0,1,-1,1.5,100,1e+21,1e-7,0.000001,9007199254740991,12.9716,-77.5946]"
    },
    {
      "name": "control-characters-and-delete",
      "value": ["\b\t\n\f\r", "\u0000\u001f", "\u007f", "<>&"],
      "canonical": "[\"\\b\\t\\n\\f\\r\",\"\\u0000\\u001f\",\"\u007f\",\"<>&\"]"
    },
    {
      "name": "array-order-kept",
      "value": [3, 1, 2, ["b", "a"]],
      "canonical": "[3,1,2,[\"b\",\"a\"]]"
    }
  ]
}
