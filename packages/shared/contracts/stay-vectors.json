      ],
      "visits": [],
      "restart_after": [],
      "expect": [
        {
          "start_ts": 1791000900,
          "end_ts": 1791003600,
          "lat": 12.9716,
          "lon": 77.5946,
          "radius_m": 33.3585,
          "sample_count": 4,
          "closed": true
        }
      ]
    },
